#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
desi_tsnr_afterburner -- Compute TSNR-based effective exposure times for all
science exposures in a DESI spectroscopic production.

Reads TSNR2 values from exposureqa PETALQA, falling back to cframe SCORES
and calculation for missing values. Joins GFA data to compute effective
times and writes an EXPOSURES+FRAMES summary FITS file.

Usage examples::

    # Process all nights in a production
    desi_tsnr_afterburner --prod ${SPECPROD} -o exposures-${SPECPROD}.fits \
        --tile-completeness tiles-${SPECPROD}.fits --gfa-proc-dir /gfa/path

    # Process a single night and merge into existing output
    desi_tsnr_afterburner --prod ${SPECPROD} -o exposures-${SPECPROD}.fits \
        --nights 20210901

    # Use MPI for multi-night parallel processing
    srun -n 8 desi_tsnr_afterburner --prod ${SPECPROD} \
        -o exposures-${SPECPROD}.fits --mpi

    # Recompute TSNR2 from cframes
    desi_tsnr_afterburner --prod ${SPECPROD} -o exposures-${SPECPROD}.fits \
        --recompute --nights 20210901
"""

import sys
from desispec.scripts.tsnr_afterburner import main

if __name__ == '__main__':
    sys.exit(main())
